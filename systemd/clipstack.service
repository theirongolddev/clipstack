# ClipStack daemon as a systemd user service. Install:
#   install -d -m 0700 ~/.local/share/clipd
#   install -D -m 0644 systemd/clipstack.service ~/.config/systemd/user/clipstack.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now clipstack.service
# The compositor must export WAYLAND_DISPLAY to the user manager, e.g. in
# Hyprland: exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY

[Unit]
Description=ClipStack clipboard history daemon
Documentation=https://github.com/theirongolddev/clipstack#running-the-daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/clipstack daemon
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# The store, and %t (the user runtime dir) for clipstack.lock and clipstack.sock
ReadWritePaths=-%h/.local/share/clipd %t
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=graphical-session.target
