#!/bin/sh
# Fake wl-paste for tests (first on PATH via TestEnv / isolate_env).
# It never execs the real wl-paste, so a test cannot read the real clipboard.
# Every invocation is logged to $FAKE_CLIP_DIR/wl-paste.calls, one line of
# space-joined arguments per call.
#
# Clipboard state lives in $FAKE_CLIP_DIR:
#   content    the selection (written by the fake wl-copy); missing = no selection
#   types      offered mime types, one per line (written by wl-copy or a test)
#   events     FIFO read by --watch, one event per line:
#                data FILE | sensitive FILE   run CMD with FILE on stdin
#                nil | clear                  run CMD with empty stdin
#                selection                    a new selection: `content` and
#                    `types` as offered, handled like wl-paste 2.3 does: no
#                    selection runs CMD with nil; an offer with no type that
#                    --type allows does not run CMD at all; otherwise CMD
#                    gets `content` with data (sensitive with the hint)
#   watch.pid  PID of the running --watch fake
#   watch-skips.log  one line per selection event --watch did not run CMD for
#
# Supported: --version, --list-types, [--no-newline] [--type text|image/png]
# and the same with --watch CMD... FAKE_WATCH_UNSUPPORTED=1 makes --watch
# fail like a compositor without the data-control protocol. Like the real
# wl-paste, pasting fails with "not available as requested type" when
# `types` offers no matching type (text: text/*, UTF8_STRING, STRING, TEXT);
# image/png is written byte for byte.

if [ -z "${FAKE_CLIP_DIR:-}" ] || [ ! -d "$FAKE_CLIP_DIR" ]; then
    echo "fake wl-paste: FAKE_CLIP_DIR is not set to a directory" >&2
    exit 1
fi
dir=$FAKE_CLIP_DIR
printf '%s\n' "$*" >> "$dir/wl-paste.calls"

unsupported() {
    echo "fake wl-paste: unsupported arguments: $*" >&2
    exit 2
}
no_selection() {
    echo "No selection" >&2
    exit 1
}

case "${1:-}" in
    --version)
        echo "wl-clipboard 2.3.0 (fake)"
        exit 0
        ;;
    --list-types)
        [ "$#" -eq 1 ] || unsupported "$@"
        [ -f "$dir/types" ] || no_selection
        cat "$dir/types"
        exit 0
        ;;
esac

all="$*"
no_newline=0
watch=0
type=text
explicit_type=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --no-newline) no_newline=1; shift ;;
        --type)
            case "${2:-}" in
                text|image/png) type=$2; explicit_type=$2 ;;
                *) unsupported "$all" ;;
            esac
            shift 2
            ;;
        --watch) shift; watch=1; break ;;
        *) unsupported "$all" ;;
    esac
done

if [ "$watch" -eq 1 ]; then
    [ "$#" -gt 0 ] || unsupported "$all"
    if [ "${FAKE_WATCH_UNSUPPORTED:-}" = 1 ]; then
        echo "Watch mode requires a compositor that supports the wlroots data-control protocol" >&2
        exit 1
    fi
    fifo="$dir/events"
    [ -p "$fifo" ] || mkfifo "$fifo" || exit 1
    echo "$$" > "$dir/watch.pid.tmp" && mv "$dir/watch.pid.tmp" "$dir/watch.pid"
    while :; do
        # Opening the FIFO blocks until a test writes to it; EOF reopens it
        while read -r state file; do
            case "$state" in
                data|sensitive) CLIPBOARD_STATE=$state "$@" < "$file" ;;
                nil|clear) CLIPBOARD_STATE=$state "$@" < /dev/null ;;
                selection)
                    if [ ! -f "$dir/content" ]; then
                        CLIPBOARD_STATE=nil "$@" < /dev/null
                        continue
                    fi
                    # wl-paste's mime_type_is_text, and what --type allows
                    text='^(text/.*|TEXT|STRING|UTF8_STRING|.*json.*|.*script|.*xml|.*yaml|.*csv|.*ini|.*application/vnd\.ms-publisher.*|.*pgp-keys)$'
                    case $explicit_type in
                        text) allowed=$text ;;
                        '') allowed='.' ;;
                        *) allowed="^$explicit_type\$" ;;
                    esac
                    if [ -f "$dir/types" ] && ! grep -Eq "$allowed" "$dir/types"; then
                        echo "selection skipped: no type allowed by --type $explicit_type" >> "$dir/watch-skips.log"
                        continue
                    fi
                    state=data
                    ! grep -qx 'x-kde-passwordManagerHint' "$dir/types" 2>/dev/null || state=sensitive
                    CLIPBOARD_STATE=$state "$@" < "$dir/content"
                    ;;
                *) echo "fake wl-paste: bad event: $state" >&2 ;;
            esac
        done < "$fifo"
    done
fi

[ -f "$dir/content" ] || no_selection
if [ -f "$dir/types" ]; then
    case $type in
        text) pattern='^(text/.*|UTF8_STRING|STRING|TEXT)$' ;;
        *) pattern="^$type\$" ;;
    esac
    if ! grep -Eq "$pattern" "$dir/types"; then
        echo "Clipboard content is not available as requested type \"$type\"" >&2
        exit 1
    fi
fi
cat "$dir/content"
[ "$no_newline" -eq 1 ] || [ "$type" != text ] || echo
