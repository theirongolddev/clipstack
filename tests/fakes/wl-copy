#!/bin/sh
# Fake wl-copy for tests (first on PATH via TestEnv / isolate_env).
# It never execs the real wl-copy, so a test cannot write the real clipboard.
# The text (arguments, else stdin) goes to $FAKE_CLIP_DIR/content and the
# offered mime types to $FAKE_CLIP_DIR/types; --sensitive adds the
# password-manager hint like wl-copy 2.3. Calls are logged to
# $FAKE_CLIP_DIR/wl-copy.calls. See the fake wl-paste for the state layout.

if [ -z "${FAKE_CLIP_DIR:-}" ] || [ ! -d "$FAKE_CLIP_DIR" ]; then
    echo "fake wl-copy: FAKE_CLIP_DIR is not set to a directory" >&2
    exit 1
fi
dir=$FAKE_CLIP_DIR
printf '%s\n' "$*" >> "$dir/wl-copy.calls"

sensitive=0
if [ "${1:-}" = --sensitive ]; then
    sensitive=1
    shift
fi
case "${1:-}" in
    -*)
        echo "fake wl-copy: unsupported arguments: $*" >&2
        exit 2
        ;;
esac

# Write to temp files and rename, so a reader never sees half a selection.
# The names are per process: concurrent copies must not share a temp file.
content_tmp="$dir/content.tmp.$$"
types_tmp="$dir/types.tmp.$$"
if [ "$#" -gt 0 ]; then
    printf '%s' "$*" > "$content_tmp"
else
    cat > "$content_tmp"
fi
{
    printf 'text/plain;charset=utf-8\ntext/plain\nUTF8_STRING\nTEXT\nSTRING\n'
    [ "$sensitive" -eq 0 ] || printf 'x-kde-passwordManagerHint\n'
} > "$types_tmp"
mv "$types_tmp" "$dir/types"
mv "$content_tmp" "$dir/content"
