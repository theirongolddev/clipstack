#!/bin/sh
# rcopy - copy stdin to your local clipboard from an SSH session.
#
#   cat file | rcopy        echo "text" | rcopy        rcopy < file
#
# It talks to the local clipstack daemon's Unix socket, forwarded by ssh:
#
#   Host myserver
#       RemoteForward /home/<remote-user>/.clipstack.sock /run/user/<local-uid>/clipstack.sock
#
# CLIPSTACK_SOCK overrides the socket path (default: $HOME/.clipstack.sock).
# Needs socat, or nc with -U (OpenBSD netcat), or ncat.
#
# Exit status: 0 copied (stderr says so if the history skipped it),
# 1 the daemon refused it, 3 no socket or no transport.

set -u
umask 077
SOCK="${CLIPSTACK_SOCK:-$HOME/.clipstack.sock}"

if command -v socat >/dev/null 2>&1; then
    transport() { socat -t 10 - "UNIX-CONNECT:$SOCK"; }
elif command -v nc >/dev/null 2>&1 && nc -h 2>&1 | grep -q -- '-U'; then
    transport() { nc -U "$SOCK"; }
elif command -v ncat >/dev/null 2>&1; then
    transport() { ncat -U "$SOCK"; }
else
    echo "rcopy: needs socat, nc (OpenBSD, with -U) or ncat" >&2
    exit 3
fi

if [ ! -S "$SOCK" ]; then
    echo "rcopy: no clipstack socket at $SOCK (is the ssh RemoteForward set up? see CLIPSTACK_SOCK)" >&2
    exit 3
fi

tmp=$(mktemp) || exit 1
trap 'rm -f "$tmp"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

cat >"$tmp" || exit 1
n=$(wc -c <"$tmp" | tr -d ' ')

reply=$({ printf 'CLIPSTACK/1 PUSH %s\n' "$n"; cat "$tmp"; } | transport 2>/dev/null)

case $reply in
    OK*" stored=0"*)
        reason=$(printf '%s\n' "$reply" | sed -n 's/.* reason=\([^ ]*\).*/\1/p')
        echo "rcopy: copied, but not saved to history (${reason:-unknown})" >&2
        ;;
    OK*) ;;
    ERR*)
        echo "rcopy: ${reply#ERR }" >&2
        exit 1
        ;;
    "")
        echo "rcopy: no reply from $SOCK (is the clipstack daemon running?)" >&2
        exit 3
        ;;
    *)
        echo "rcopy: unexpected reply: $reply" >&2
        exit 1
        ;;
esac
